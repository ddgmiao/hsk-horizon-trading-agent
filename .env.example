HSK_RPC_URL=https://testnet.hsk.xyz
HSK_CHAIN_ID=133
HSK_AGENT_KEY_FILE=/absolute/path/to/your/key-file.json

# Defaults are the testnet candidates documented in DISCOVERY.md.
HSK_FACTORY=0x2dC2c21D1049F786C535bF9d45F999dB5474f3A0
HSK_ROUTER=0xa6914E66690c6794244B5f66a09eAEbf66254237
HSK_QUOTER=0x73820d9eE5Bf1BfcD429580320FC7A374E8fa1cC
# Trading requires this address when local deployment metadata is absent. The keyless audit has a published default.
HSK_DECISION_LOG_ADDRESS=0xfb3e5F2d31A1a473CC09C847A4B564C0c2C46FD1
HSK_TOKEN0=0x0284eA6081C90fd5a48BCCc324C7bE1e46ea8cDb
HSK_TOKEN1=0xC383e13C47112b76be60f41ef5E5d8f9A8E75aE5
HSK_POOL=0xf826C65abDFF3B817e846DB4dfB68107CEFeB6b5
HSK_POOL_FEE=3000
HSK_WHSK=0xCA8aAceEC5Db1e91B9Ed3a344bA026c4a2B3ebF6
HSK_BOOTSTRAP_POOL=0x9fCdf0d609B36e2C8F8a194BeD2583c772d6EF76

HSK_TARGET_TOKEN1_BPS=5000
HSK_REBALANCE_BAND_BPS=500
HSK_MAX_TRADE_INPUT=0.1
HSK_MAX_POSITION_QUOTE=2
HSK_MAX_SLIPPAGE_BPS=100
HSK_MIN_TRADE_INTERVAL_SECONDS=300
HSK_MAX_DAILY_LOSS_BPS=500
# Rebalance only: allocation error removed (TT1) >= multiple * whole-path gas cost (HSK) * pinned TT1/WHSK mark.
# Integer range: 1..1000; bootstrap is exempt.
HSK_MIN_GAS_MULTIPLE=2
# Swap cost estimate: (0, 1] HSK, at most 18 decimals; above the measured 0.000142 HSK swap.
HSK_ESTIMATED_GAS_HSK=0.00015
# Add registry gas on every rebalance, and approval gas only when allowance is insufficient.
HSK_ESTIMATED_APPROVAL_GAS_HSK=0.000046321
HSK_ESTIMATED_REGISTRY_GAS_HSK=0.000035773
# Initial provisioning only: never reseed an already provisioned wallet.
HSK_MIN_TRADABLE_NOTIONAL_QUOTE=0.01
HSK_BOOTSTRAP_HSK=0.01
# Measured fees: 0.000300 HSK one-off deployment, 0.000036-0.000142 HSK per routine transaction; keep room to wrap and trade after the 0.1 HSK faucet drip.
HSK_HSK_GAS_RESERVE=0.02
HSK_POLL_SECONDS=30
HSK_MAX_CYCLES=0
